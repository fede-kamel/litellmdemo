# Verifying routes

## The checks, in order

```shell
scripts/preflight.sh                                                     # every piece, end to end   -> PREFLIGHT OK (n/n)
LITELLM_GATEWAY=http://127.0.0.1:30400 uv run python scripts/probe_routes.py   # each routing behaviour -> ROUTES OK (n/n)
uv run python scripts/e2e.py --evidence evidence/openshell              # every use case, in the sandbox -> E2E OK (n/n)
(cd web && node scripts/ui-e2e.mjs)                                     # the screens, clicked     -> UI E2E OK (n/n)
uv run python scripts/failover.py                                       # a dead primary gateway   -> FAILOVER OK (n/n)
scripts/oci/chaos.sh                                                    # a classifier outage      -> CHAOS OK
```

`e2e.py` runs the agent inside the OpenShell sandbox and records, per use
case, the runtime and the sandbox's network decisions; every run should be
`openshell` only, with no denied connection.

Each probe asks for a model group and checks the route from the response
headers (`x-litellm-complexity-router-tier`, `x-litellm-model-name`,
`x-litellm-attempted-fallbacks`, ...). A probe that fails prints the gateway's
error. Match it against the quirks table in the `litellm-oci-gateway` skill
before changing anything.

## Reading a failure

| Probe output | Usual cause |
|---|---|
| SIMPLE answers come from `oci-fast-backup` | a tier deployment rejects the router's `max_tokens`: declare the model's real `max_output_tokens` |
| `cause=classifier_fallback` on `oci-auto-trained` | the plugin declined or timed out: model not trained, or the gateway started before training |
| 401 from OCI | the OCI session expired: the operator re-authenticates; the gateway reloads within a minute |
| 404 `Entity with key` | the model is not served on demand in this tenancy |

## Publishing evidence

```shell
uv run python scripts/probe_routes.py --json > evidence/probe-routes.jsonl
uv run python scripts/e2e.py --evidence evidence
```

Before committing evidence, scan it: no OCIDs, no profile names, no keys.

```shell
grep -rlE "ocid1\.|BEGIN .*PRIVATE|sk-[A-Za-z0-9_-]{20,}" evidence/ && echo "STOP: redact first"
```

Never edit routing code to make a check pass without saying why: a failing
probe is information.
"""End-to-end: every use case through the web app, the agent, the gateway and OCI.

    uv run uvicorn ui.server:app --port 8780 &        # web app (gateway on 4000)
    uv run python scripts/e2e.py                      # ends with E2E OK (n/n)
    uv run python scripts/e2e.py --evidence evidence  # also write evidence/e2e.jsonl
    LITELLMDEMO_APP=https://<host> uv run python scripts/e2e.py   # the public control room

For each scenario in app/scenarios.py the langchain-oci agent runs once,
asking the gateway for `oci-auto-trained` (or the scenario's own group).
Checks: the first model call took the route the scenario expects, the
premium request took the premium lane, the failing deployment fell back, the
multi-step agent planned and routed every step, a route with one primary
group (code, multilingual) never fell back and answered from its own models,
and the agent produced an answer.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import httpx
import yaml

BASE = os.environ.get("LITELLMDEMO_APP", "http://127.0.0.1:8780")
ROOT = Path(__file__).resolve().parents[1]

# Routes with one primary group: a run on them must not fall back, and every call must be answered by that
# group's own models, so a failing primary shows here instead of passing on its backup (gateway/config.yaml).
PRIMARY = {"CODE": "oci-code", "MULTILINGUAL": "oci-multilingual"}
MODELS = {route: {d["litellm_params"]["model"].split("/", 1)[-1]
                  for d in yaml.safe_load((ROOT / "gateway" / "config.yaml").read_text())["model_list"] if d["model_name"] == group}
          for route, group in PRIMARY.items()}


def run(client: httpx.Client, scenario: str) -> list[dict]:
    rid = client.post(f"{BASE}/api/runs", json={"scenario": scenario}).json()["id"]
    events: list[dict] = []
    with client.stream("GET", f"{BASE}/api/runs/{rid}/stream", timeout=600) as r:
        for line in r.iter_lines():
            if line.startswith("event: end"):
                break
            if line.startswith("data: ") and line != "data: {}":
                events.append(json.loads(line[6:]))
    return events


def check(s: dict, events: list[dict]) -> tuple[bool, str]:
    calls = [e for e in events if e["type"] == "llm"]
    answer = next((e for e in events if e["type"] == "answer"), None)
    error = next((e for e in events if e["type"] == "error"), None)
    if error or not calls or not answer or not answer["text"].strip():
        return False, f"no answer: {error and error['message']}"
    first = calls[0]
    expect = s["expect"]
    if expect == "premium lane":
        ok = "gpt-5.2" in (first.get("deployment") or "")
    elif expect == "fallback":
        ok = first.get("fallbacks", 0) >= 1 and first.get("group") == "oci-balanced"
    elif expect == "a route per step":
        # a plan of at least two steps, every step answered, and each step routed on its own
        plan = next((e for e in events if e["type"] == "plan"), {"steps": []})
        done = {e["step"] for e in events if e["type"] == "step_done"}
        routes = [next((c.get("route") for c in calls if c.get("step") == i), None) for i in range(1, len(plan["steps"]) + 1)]
        ok = len(plan["steps"]) >= 2 and done == set(range(1, len(plan["steps"]) + 1)) and all(routes)
        # each multi-step use case names facts its answer must contain (app/scenarios.py, "check", with the arithmetic)
        text = answer["text"].replace("\u202f", " ")
        missing = [group[0] for group in s.get("check", []) if not any(x in text for x in group)]
        ok = ok and not missing
        return ok, f"facts={'ok' if not missing else 'MISSING ' + ','.join(missing)} steps={len(plan['steps'])} routes={'/'.join(r or '-' for r in routes)} calls={len(calls)} spend=${sum(c.get('cost') or 0 for c in calls):.5f}"
    else:
        ok = first.get("route") in s.get("accept", [expect])
        if ok and expect in MODELS:
            strayed = [f"call {c.get('call')} {c.get('deployment')} fallbacks={c.get('fallbacks', 0)}" for c in calls
                       if c.get("fallbacks", 0) or (c.get("deployment") or "").split("/", 1)[-1] not in MODELS[expect]]
            if strayed:
                return False, f"route={first.get('route')} but a call left the route's own models: " + "; ".join(strayed)
    spend = sum(c.get("cost") or 0 for c in calls)
    return ok, (f"route={first.get('route') or first.get('group')} deployment={first.get('deployment')} "
                f"calls={len(calls)} fallbacks={sum(c.get('fallbacks', 0) for c in calls)} spend=${spend:.5f}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--evidence", help="write e2e.jsonl to this directory")
    ap.add_argument("--only", help="run scenarios whose id contains this text")
    args = ap.parse_args()
    lines, ok_count = [], 0
    with httpx.Client(timeout=120) as client:
        scenarios = [s for s in client.get(f"{BASE}/api/scenarios").json() if not args.only or args.only in s["id"]]
        for s in scenarios:
            events = run(client, s["id"])
            ok, detail = check(s, events)
            ok_count += ok
            print(f"{'PASS' if ok else 'FAIL'}  {s['id']:20s} expect {s['expect']:13s} {detail}", flush=True)
            lines.append({"scenario": s["id"], "use_case": s["use_case"], "expect": s["expect"], "passed": ok,
                          "runtime": [e.get("runtime") for e in events if e["type"] == "runtime"],
                          "sandbox_network": next((e["events"] for e in events if e["type"] == "sandbox_net"), None),
                          "detail": detail, "calls": [{k: e.get(k) for k in ("call", "route", "cause", "group", "deployment", "gateway",
                                                                              "fallbacks", "retries", "cost", "seconds", "tool_calls")}
                                                     for e in events if e["type"] == "llm"],
                          "classifier": [{k: e.get(k) for k in ("call", "route", "criterion", "probabilities", "milliseconds")}
